#!/usr/bin/env python3
"""macOS standalone collector: Antigravity usage -> $AGENT_USAGE_DIR/agy.json (default ~/.local/state/agent-usage-bar/usage)

100% Python 3 stdlib, no external dependencies.
Local stats come from Antigravity's history log, conversation summaries, and
conversation transcripts under ~/.gemini/antigravity-cli/, plus any Antigravity
sessions recorded by pi, omp, OpenClaw, or opencode.
Limits come from the Google Cloud Code API (v1internal:loadCodeAssist,
retrieveUserQuotaSummary, fetchAvailableModels) using the token in macOS
Keychain (service="gemini", account="antigravity") or ~/.gemini/antigravity-cli/
antigravity-oauth-token, falling back to `agy -p "/quota"` when the quota
summary omits the Gemini group. Never prints or logs tokens.
"""

